"""U-Boot little-endian redundant environment encoder (unsigned D213 only)."""
import argparse
from pathlib import Path
import struct
import zlib
p = argparse.ArgumentParser()
p.add_argument('-r', action='store_true')
p.add_argument('-s', type=int, required=True)
p.add_argument('-o', required=True)
p.add_argument('input')
a = p.parse_args()
lines = [v for v in Path(a.input).read_bytes().splitlines() if v and not v.startswith(b'#')]
payload = b'\0'.join(lines) + b'\0\0'
length = a.s - 4 - int(a.r)
if len(payload) > length: p.error('environment exceeds configured size')
payload = payload.ljust(length, b'\xff')
Path(a.o).write_bytes(struct.pack('<I', zlib.crc32(payload)) + (b'\x01' if a.r else b'') + payload)
